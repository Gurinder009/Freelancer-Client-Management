// Prisma schema for WorkBridge

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  password         String
  role             String            @default("CLIENT") // CLIENT, FREELANCER, ADMIN
  status           String            @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING
  isVerified       Boolean           @default(false)
  refreshToken     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  profile          Profile?
  clientProfile    ClientProfile?
  freelancerProfile FreelancerProfile?
  
  projects         Project[]         @relation("ClientProjects")
  proposals        Proposal[]        @relation("FreelancerProposals")
  contractsAsClient Contract[]       @relation("ClientContracts")
  contractsAsFreelancer Contract[]   @relation("FreelancerContracts")
  
  messagesSent     Message[]         @relation("SentMessages")
  conversations    ConversationParticipant[]
  
  notifications    Notification[]
  reviewsGiven     Review[]          @relation("Reviewer")
  reviewsReceived  Review[]          @relation("ReviewTarget")
  transactions     Transaction[]
  bookmarks        Bookmark[]
  reportsSubmitted Report[]          @relation("Reporter")
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  avatarUrl   String?
  phone       String?
  location    String?
  bio         String?
  timezone    String?  @default("UTC+05:30")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ClientProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName           String?
  industry              String?
  companySize           String?
  website               String?
  hiringNeeds           String?
  totalSpent            Float    @default(0)
  completedProjectsCount Int     @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model FreelancerProfile {
  id                     String      @id @default(uuid())
  userId                 String      @unique
  user                   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  professionalTitle      String
  hourlyRate             Float       @default(35.0)
  experienceLevel        String      @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, EXPERT
  availability           String      @default("AVAILABLE") // AVAILABLE, BUSY, NOT_AVAILABLE
  responseTime           String      @default("Within 2 hours")
  totalEarnings          Float       @default(0)
  completedProjectsCount Int         @default(0)
  rating                 Float       @default(5.0)
  reviewCount            Int         @default(0)
  successRate            Int         @default(100)
  education              String?     // JSON string
  certifications         String?     // JSON string
  workHistory            String?     // JSON string
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  skills                 FreelancerSkill[]
  portfolios             Portfolio[]
  bookmarks              Bookmark[]
}

model Skill {
  id         String            @id @default(uuid())
  name       String            @unique
  category   String?
  freelancers FreelancerSkill[]
  projects   ProjectSkill[]
}

model FreelancerSkill {
  id                  String            @id @default(uuid())
  freelancerProfileId String
  freelancer          FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  skillId             String
  skill               Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([freelancerProfileId, skillId])
}

model Portfolio {
  id                  String            @id @default(uuid())
  freelancerProfileId String
  freelancer          FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  title               String
  description         String
  imageUrl            String?
  projectUrl          String?
  technologies        String?           // Comma separated or JSON string
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  icon        String?
  description String?
  projects    Project[]
}

model Project {
  id              String         @id @default(uuid())
  title           String
  description     String
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])
  clientId        String
  client          User           @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Cascade)
  budgetType      String         @default("FIXED") // FIXED, HOURLY
  budget          Float
  deadline        DateTime
  experienceLevel String         @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, EXPERT
  status          String         @default("OPEN") // OPEN, IN_PROGRESS, COMPLETED, CANCELLED
  attachments     String?        // JSON or URL string
  views           Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  skills          ProjectSkill[]
  proposals       Proposal[]
  contracts       Contract[]
  bookmarks       Bookmark[]
}

model ProjectSkill {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([projectId, skillId])
}

model Proposal {
  id              String      @id @default(uuid())
  projectId       String
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  freelancerId    String
  freelancer      User        @relation("FreelancerProposals", fields: [freelancerId], references: [id], onDelete: Cascade)
  coverLetter     String
  proposedBudget  Float
  deliveryTime    String
  milestonesPlan  String?     // JSON string of proposed milestones
  relevantExperience String?
  attachments     String?
  status          String      @default("SUBMITTED") // SUBMITTED, SHORTLISTED, ACCEPTED, REJECTED, WITHDRAWN
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  contracts       Contract[]

  @@unique([projectId, freelancerId])
}

model Contract {
  id             String           @id @default(uuid())
  contractNumber String           @unique
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id])
  clientId       String
  client         User             @relation("ClientContracts", fields: [clientId], references: [id])
  freelancerId   String
  freelancer     User             @relation("FreelancerContracts", fields: [freelancerId], references: [id])
  proposalId     String?
  proposal       Proposal?        @relation(fields: [proposalId], references: [id])
  totalBudget    Float
  paymentTerms   String?          @default("Milestone-based Escrow")
  status         String           @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED, CANCELLED
  startDate      DateTime         @default(now())
  endDate        DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  milestones     Milestone[]
  submissions    WorkSubmission[]
  reviews        Review[]
  transactions   Transaction[]
}

model Milestone {
  id          String           @id @default(uuid())
  contractId  String
  contract    Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title       String
  description String?
  amount      Float
  dueDate     DateTime?
  order       Int              @default(1)
  status      String           @default("PENDING") // PENDING, IN_PROGRESS, SUBMITTED, APPROVED, REVISION_REQUESTED, PAID
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  submissions WorkSubmission[]
  transactions Transaction[]
}

model WorkSubmission {
  id           String     @id @default(uuid())
  milestoneId  String
  milestone    Milestone  @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  contractId   String
  contract     Contract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  freelancerId String
  description  String
  githubUrl    String?
  liveDemoUrl  String?
  fileUrls     String?    // JSON array of file paths or links
  notes        String?
  status       String     @default("SUBMITTED") // SUBMITTED, REVISION_REQUESTED, APPROVED
  reviewNotes  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Conversation {
  id           String                   @id @default(uuid())
  projectId    String?
  contractId   String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  attachmentUrl  String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // PROPOSAL, CONTRACT, MILESTONE, MESSAGE, PAYMENT, REVIEW, SYSTEM
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Transaction {
  id                String     @id @default(uuid())
  transactionNumber String     @unique
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  contractId        String?
  contract          Contract?  @relation(fields: [contractId], references: [id])
  milestoneId       String?
  milestone         Milestone? @relation(fields: [milestoneId], references: [id])
  amount            Float
  type              String     // DEPOSIT, ESCROW_HOLD, ESCROW_RELEASE, PAYOUT, REFUND
  status            String     @default("COMPLETED") // PENDING, PROCESSING, COMPLETED, FAILED, REFUNDED
  paymentMethod     String     @default("STRIPE_MOCK") // STRIPE_MOCK, BANK_TRANSFER, WALLET
  description       String
  createdAt         DateTime   @default(now())
}

model Review {
  id                    String   @id @default(uuid())
  contractId            String
  contract              Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  reviewerId            String
  reviewer              User     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  targetUserId          String
  targetUser            User     @relation("ReviewTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  overallRating         Int      @default(5)
  communicationRating   Int      @default(5)
  qualityRating         Int      @default(5)
  professionalismRating Int      @default(5)
  timelinessRating      Int      @default(5)
  comment               String
  createdAt             DateTime @default(now())

  @@unique([contractId, reviewerId])
}

model Bookmark {
  id                  String             @id @default(uuid())
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId           String?
  project             Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  freelancerProfileId String?
  freelancerProfile   FreelancerProfile? @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  createdAt           DateTime           @default(now())

  @@unique([userId, projectId, freelancerProfileId])
}

model Report {
  id          String   @id @default(uuid())
  reporterId  String
  reporter    User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType  String   // USER, PROJECT, REVIEW, MESSAGE
  targetId    String
  reason      String
  description String
  evidenceUrl String?
  status      String   @default("PENDING") // PENDING, UNDER_REVIEW, RESOLVED, REJECTED
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}
